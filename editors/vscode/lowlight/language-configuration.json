{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "#[",
      "]"
    ],
    [
      "+[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "/*",
      "close": "*/",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "`",
      "`"
    ]
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*[?!]?",
  "indentationRules": {
    "increaseIndentPattern": "^((?!\\/\\/).)*(\\{[^}\"'`]*|\\([^)\"'`]*|\\[[^\\]\"'`]*|:)\\s*(\\/\\/.*)?$",
    "decreaseIndentPattern": "^\\s*(\\}|\\)|\\])"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*\\/\\/.*\\S",
      "afterText": "^\\s*\\S",
      "action": {
        "indent": "none",
        "appendText": "// "
      }
    },
    {
      "beforeText": "^((?!\\/\\/).)*:\\s*(\\/\\/.*)?$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "previousLineText": "^((?!\\/\\/).)*:\\s*(\\/\\/.*)?$",
      "beforeText": "^\\s+(?!when\\b|default\\b|else\\b|\\/\\/)\\S.*[^:{(\\[,\\s]\\s*$",
      "action": {
        "indent": "outdent"
      }
    }
  ]
}
