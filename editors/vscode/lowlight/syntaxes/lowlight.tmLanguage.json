{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lowlight",
  "scopeName": "source.lowlight",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#optional-identifiers"
    },
    {
      "include": "#result-identifiers"
    }
  ],
  "repository": {
    "attributes": {
      "patterns": [
        {
          "comment": "`@derive(Equatable, Printable)`: the derived interfaces are type names",
          "begin": "(@derive)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "storage.type.annotation.lowlight"
            },
            "2": {
              "name": "punctuation.section.parens.begin.lowlight"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.parens.end.lowlight"
            }
          },
          "patterns": [
            {
              "name": "entity.name.type.interface.lowlight",
              "match": "\\b(Equatable|Comparable|Hashable|Copyable|Printable)\\b"
            },
            {
              "name": "entity.name.type.lowlight",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.lowlight",
              "match": ","
            }
          ]
        },
        {
          "name": "storage.type.annotation.lowlight",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lowlight",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.lowlight"
            }
          },
          "patterns": [
            {
              "include": "#comment-doc"
            }
          ]
        },
        {
          "name": "comment.block.lowlight",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.lowlight"
            }
          },
          "patterns": [
            {
              "include": "#comment-doc"
            }
          ]
        }
      ]
    },
    "comment-doc": {
      "patterns": [
        {
          "name": "markup.heading.lowlight",
          "match": "^\\s*#\\s+(Arguments|Returns|Errors|Panics|Examples|Safety|Complexity|Notes?)\\b.*$"
        },
        {
          "name": "markup.underline.link.lowlight",
          "match": "\\[`[^`]+`\\]"
        },
        {
          "name": "markup.inline.raw.string.lowlight",
          "match": "`[^`]+`"
        },
        {
          "name": "keyword.codetag.notation.lowlight",
          "match": "\\b(TODO|FIXME|XXX|NOTE|WARNING)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.backtick.lowlight",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lowlight"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lowlight"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.lowlight",
              "match": "\\\\([nrt\\\\'\"0$`]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})"
            },
            {
              "name": "meta.embedded.line.lowlight",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.lowlight"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.lowlight"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "name": "variable.other.interpolated.lowlight",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*\\??"
            }
          ]
        },
        {
          "name": "string.quoted.double.lowlight",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lowlight"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lowlight"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.lowlight",
              "match": "\\\\([nrt\\\\'\"0$]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})"
            },
            {
              "name": "meta.embedded.line.lowlight",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.lowlight"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.lowlight"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "name": "variable.other.interpolated.lowlight",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*\\??"
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.lowlight",
          "match": "'(\\\\([nrt\\\\'\"0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.lowlight",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.lowlight",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.lowlight",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9_]+)\\b|\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.lowlight",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(define)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\[[^\\]]*\\])?\\s+(result)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.lowlight"
            },
            "2": {
              "name": "entity.name.type.lowlight"
            },
            "3": {
              "name": "keyword.declaration.type.lowlight"
            }
          }
        },
        {
          "match": "\\b(define)\\s+(?:(packed)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.lowlight"
            },
            "2": {
              "name": "storage.modifier.lowlight"
            },
            "3": {
              "name": "entity.name.type.lowlight"
            }
          }
        },
        {
          "match": "\\b(bind|const)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\[[^\\]]*\\])?\\.([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.lowlight"
            },
            "2": {
              "name": "entity.name.type.lowlight"
            },
            "3": {
              "name": "entity.name.function.method.lowlight"
            }
          }
        },
        {
          "match": "\\b(bind|const)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(\\[[^\\]]*\\])?\\s*=\\s*fn\\s*\\()",
          "captures": {
            "1": {
              "name": "keyword.declaration.lowlight"
            },
            "2": {
              "name": "entity.name.function.lowlight"
            }
          }
        },
        {
          "match": "\\b(extern)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.other.extern.lowlight"
            },
            "2": {
              "name": "entity.name.function.extern.lowlight"
            },
            "3": {
              "name": "keyword.control.as.lowlight"
            },
            "4": {
              "name": "entity.name.function.lowlight"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lowlight",
          "match": "\\b(if|else|for|while|in|match|when|next|func|as)(?!\\?)\\b"
        },
        {
          "match": "\\b(default)\\s+(panic)\\b(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "keyword.control.lowlight"
            },
            "2": {
              "name": "keyword.control.lowlight"
            }
          }
        },
        {
          "name": "keyword.control.lowlight",
          "match": "^\\s*\\bdefault\\b(?=\\s*(:|[A-Z_a-z]))"
        },
        {
          "name": "keyword.control.comptime.lowlight",
          "match": "\\b(comptime)(?!\\?)\\b"
        },
        {
          "name": "keyword.declaration.lowlight",
          "match": "\\b(let|bind|const|define|distinct|struct|enum|interface|import|extern)(?!\\?)\\b"
        },
        {
          "name": "storage.modifier.ownership.lowlight",
          "match": "\\b(own|unsafe|unpack)(?!\\?)\\b"
        },
        {
          "comment": "`fn` (a function that captures nothing) and `cl` (a closure) start function literals and types",
          "name": "storage.type.function.lowlight",
          "match": "\\b(fn|cl)(?=\\s*\\()"
        },
        {
          "name": "keyword.operator.logical.lowlight",
          "match": "\\b(and|or|not)(?!\\?)\\b"
        },
        {
          "name": "constant.language.lowlight",
          "match": "\\b(true|false|none)(?!\\?)\\b"
        },
        {
          "name": "variable.language.self.lowlight",
          "match": "\\b(self|Self)(?!\\?)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.lowlight",
          "match": "\\b(int|i8|i16|i32|i64|u8|u16|u32|u64|float|f32|f64|bool|char|string|void|never|Arena|ptr|ref)(?!\\?)\\b"
        },
        {
          "name": "entity.name.type.interface.lowlight",
          "match": "\\b(Printable|Copyable|Drop|Equatable|Comparable|Hashable|Addable|AddAssignable|Iterator|Iterable|Collectable|Indexable|KeyIndexable|Containable)(?!\\?)\\b"
        },
        {
          "name": "entity.name.type.lowlight",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?!\\?)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.lowlight",
          "match": "\\b(print|println|eprint|eprintln|panic|assert|exit|parse_int|parse_float|sqrt|abs|min|max|read_file|write_file|args|caller_location|caller_file|caller_line|caller_col|compile_error)(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.comptime.lowlight",
          "match": "\\b(?:comp\\.(?:TARGET|embed_str|embed_bytes|type_name|kind_of|fields_of|variants_of|elems_of|underlying_of|attrs_of|implements|compile_error|log)|type\\.(?:size_of|align_of|is_plain))\\b"
        },
        {
          "name": "support.function.intrinsic.lowlight",
          "match": "\\b(size_of|align_of|alloc_raw|realloc_raw|free_raw|null_ptr|is_null|addr_of|ptr_add|ptr_read|ptr_write|ptr_cast|ptr_addr|copy_bytes|zero_bytes|alloc_uninit|fill_bytes|syscall|ref_from_ptr)(?=\\s*(\\[|\\())"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tuple.lowlight",
          "match": "\\+\\["
        },
        {
          "name": "keyword.control.unwind.lowlight",
          "match": "(?<=^|\\s)<-(?=\\s|;|\\}|\\)|,|$|//|/\\*)"
        },
        {
          "name": "keyword.operator.arrow.lowlight",
          "match": "->"
        },
        {
          "name": "keyword.operator.optional.lowlight",
          "match": "\\?\\?|\\?\\."
        },
        {
          "name": "keyword.operator.range.lowlight",
          "match": "\\.\\.=|\\.\\."
        },
        {
          "name": "keyword.operator.comparison.lowlight",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.lowlight",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|="
        },
        {
          "name": "keyword.operator.bitwise.lowlight",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.lowlight",
          "match": "\\+|-|\\*|/|%|<|>"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "(?:\\.|\\?\\.)([0-9]+|[a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*(\\[[^\\]]*\\])?\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.method.lowlight"
            }
          }
        },
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.lowlight"
            }
          }
        }
      ]
    },
    "optional-identifiers": {
      "patterns": [
        {
          "name": "variable.other.optional.lowlight",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\?(?!\\?|\\.)"
        }
      ]
    },
    "result-identifiers": {
      "patterns": [
        {
          "name": "variable.other.result.lowlight",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*!(?!=)"
        }
      ]
    }
  }
}
