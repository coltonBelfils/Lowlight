{
  "Main Entry Point": {
    "prefix": "main",
    "body": [
      "bind main = fn(): {",
      "\t$0",
      "}"
    ],
    "description": "Program entry point"
  },
  "Function Binding": {
    "prefix": "fn",
    "body": [
      "bind ${1:name} = fn(${2:x: int}) ${3:int}: {",
      "\t$0",
      "}"
    ],
    "description": "Top-level function with a block body"
  },
  "Expression Function": {
    "prefix": "fne",
    "body": [
      "bind ${1:name} = fn(${2:x: int}) ${3:int}: ${0:x}"
    ],
    "description": "Top-level single-expression function"
  },
  "Method Binding": {
    "prefix": "meth",
    "body": [
      "bind ${1:Type}.${2:method} = fn(${3:self}) ${4:int}: {",
      "\t$0",
      "}"
    ],
    "description": "Method on a type (`&self` mutates, `own self` consumes)"
  },
  "Constant Binding": {
    "prefix": "const",
    "body": [
      "const ${1:NAME}: ${2:int} = ${0:0}"
    ],
    "description": "Top-level compile-time constant"
  },
  "Const Function Binding": {
    "prefix": "constfn",
    "body": [
      "const ${1:name} = fn(${2:x: int}) ${3:int}: {",
      "\t$0",
      "}"
    ],
    "description": "Compile-time-capable function declaration"
  },
  "Comptime Block": {
    "prefix": "comptime",
    "body": [
      "comptime {",
      "\t$0",
      "}"
    ],
    "description": "Compile-time evaluation block"
  },
  "Drop Destructor": {
    "prefix": "drop",
    "body": [
      "bind ${1:Type}.drop = fn(&self): {",
      "\t$0",
      "}"
    ],
    "description": "Custom `drop` destructor called when a value leaves scope"
  },
  "Extern C Function": {
    "prefix": "extern",
    "body": [
      "extern ${1:c_func}: fn(${2:x: i32}) ${3:i32}"
    ],
    "description": "C11 extern function declaration (callable inside `unsafe`)"
  },
  "Function Literal": {
    "prefix": [
      "fnl",
      "lambda"
    ],
    "body": [
      "fn(${1:x: int}) ${2:int}: ${0:x}"
    ],
    "description": "Function value that captures nothing (`fn`); converts to a closure where one is expected"
  },
  "Closure Literal": {
    "prefix": [
      "cl",
      "closure"
    ],
    "body": [
      "cl(${1:x: int}) ${2:int}: ${0:x}"
    ],
    "description": "Closure that captures variables (`cl`)"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "define ${1:Name} struct [",
      "\t${2:x}: ${3:int},",
      "\t${4:y}: ${5:int},",
      "]"
    ],
    "description": "Value struct"
  },
  "Packed Struct Definition": {
    "prefix": "packed",
    "body": [
      "@packed",
      "define ${1:Header} struct [",
      "\t${2:tag}: ${3:u8},",
      "\t${4:len}: ${5:u32},",
      "]"
    ],
    "description": "C-ABI packed struct without padding"
  },
  "Distinct Type": {
    "prefix": "distinct",
    "body": [
      "define ${1:UserId} ${2:int}"
    ],
    "description": "Distinct newtype wrapper"
  },
  "Derive Struct": {
    "prefix": [
      "derive"
    ],
    "body": [
      "@derive(${1:Equatable, Printable})",
      "define ${2:Name} struct [",
      "\t${3:x}: ${4:int},",
      "\t${5:y}: ${6:int},",
      "]"
    ],
    "description": "Struct with methods written by `@derive` (Equatable, Comparable, Hashable, Copyable, Printable)"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": [
      "define ${1:Status} enum [",
      "\t${2:active},",
      "\t${3:stopped},",
      "]"
    ],
    "description": "Tag enum"
  },
  "Result Definition": {
    "prefix": "result",
    "body": [
      "define ${1:Lookup} result [",
      "\tvalue: ${2:string},",
      "\t${3:missing}: ${4:string},",
      "\t${5:forbidden},",
      "]"
    ],
    "description": "Result type: one `value` member plus failure variants"
  },
  "Interface Definition": {
    "prefix": "interface",
    "body": [
      "define ${1:Name} interface [",
      "\t${2:method}: fn(self) ${3:string}",
      "]"
    ],
    "description": "Structural interface"
  },
  "If Else Expression": {
    "prefix": "if",
    "body": [
      "if(${1:cond}): ${2:a} else: ${0:b}"
    ],
    "description": "Single-expression conditional"
  },
  "Optional Narrowing If": {
    "prefix": "if?",
    "body": [
      "if(${1:opt}?): {",
      "\t$0",
      "}"
    ],
    "description": "Narrow `opt?` to `opt` inside the branch"
  },
  "If As Binding": {
    "prefix": "ifas",
    "body": [
      "if(${1:expr} as ${2:v}): ${3:v} else: ${0:fallback}"
    ],
    "description": "Bind an optional's value or a result's success value"
  },
  "If As Block": {
    "prefix": "ifasb",
    "body": [
      "if(${1:expr} as ${2:v}): {",
      "\t$0",
      "}"
    ],
    "description": "Bind an optional's or result's value inside an `if` block"
  },
  "For Range Loop": {
    "prefix": "forr",
    "body": [
      "for(${1:i} in ${2:0}..${3:n}): {",
      "\t$0",
      "}"
    ],
    "description": "Loop over a range"
  },
  "For Collection Loop": {
    "prefix": "forin",
    "body": [
      "for(${1:item} in ${2:items}): {",
      "\t$0",
      "}"
    ],
    "description": "Loop over a collection"
  },
  "For Index Loop": {
    "prefix": "fori",
    "body": [
      "for(${1:i}, ${2:item} in ${3:items}): {",
      "\t$0",
      "}"
    ],
    "description": "Loop with each element's index (or a map's keys and values)"
  },
  "For Collecting Expression": {
    "prefix": "forc",
    "body": [
      "bind ${1:items} = for(${2:x} in ${3:xs}): ${0:x}"
    ],
    "description": "Collect elements from a `for` comprehension into a list"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while(${1:cond}): {",
      "\t$0",
      "}"
    ],
    "description": "Conditional loop"
  },
  "While Search Loop": {
    "prefix": "whiles",
    "body": [
      "bind ${1:found?} = while(${2:x} in ${3:xs}): if(${4:cond}): while <- $2"
    ],
    "description": "Search loop yielding `?T` via `while <-`"
  },
  "Match Expression": {
    "prefix": "match",
    "body": [
      "match(${1:value}):",
      "\twhen ${2:pattern}: ${3:expr}",
      "\tdefault: ${0:expr}"
    ],
    "description": "Exhaustive match ending in `default`"
  },
  "Result Chain": {
    "prefix": "chain",
    "body": [
      "${1:load()}:",
      "\tdefault err(${2:e}): func <- err($2.wrap(\"${3:context}\"))"
    ],
    "description": "Evaluate to the value; propagate `err` with context"
  },
  "Result Chain When": {
    "prefix": "chainw",
    "body": [
      "${1:find(key)}:",
      "\twhen ${2:missing}(${3:_}): ${4:fallback}",
      "\tdefault panic"
    ],
    "description": "Handle listed failures; panic on the rest"
  },
  "Unwrap Result": {
    "prefix": "unwrap",
    "body": [
      "${1:load()}: default panic"
    ],
    "description": "Evaluate to the value; panic on any failure"
  },
  "Test Function": {
    "prefix": "test",
    "body": [
      "@test(\"${1:description}\")",
      "bind test_${2:name} = fn(): {",
      "\t$0",
      "}"
    ],
    "description": "Unit test run by `lowlight test`"
  },
  "Unsafe Block": {
    "prefix": "unsafe",
    "body": [
      "unsafe {",
      "\t$0",
      "}"
    ],
    "description": "Block allowing raw pointer operations"
  }
}
