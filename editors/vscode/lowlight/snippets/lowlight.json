{
  "Main Entry Point": {
    "prefix": "main",
    "body": [
      "bind main = () void: {",
      "\t$0",
      "}"
    ],
    "description": "Define the Lowlight main entry point"
  },
  "Function Binding": {
    "prefix": "fn",
    "body": [
      "bind ${1:name} = (${2:params}) ${3:int}: {",
      "\t$0",
      "}"
    ],
    "description": "Define a top-level Lowlight function"
  },
  "Method Binding": {
    "prefix": "meth",
    "body": [
      "bind ${1:Type}.${2:method} = (${3:self}) ${4:void}: {",
      "\t$0",
      "}"
    ],
    "description": "Define a method on a nominal type"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "define ${1:Name} struct [",
      "\t${2:field}: ${3:int},",
      "]"
    ],
    "description": "Define a value struct"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": [
      "define ${1:Status} enum [",
      "\t${2:Ok},",
      "\t${3:Err},",
      "]"
    ],
    "description": "Define a strongly-typed enum"
  },
  "Interface Definition": {
    "prefix": "interface",
    "body": [
      "define ${1:Name} interface [",
      "\t${2:method}: (self) ${3:string},",
      "]"
    ],
    "description": "Define an interface"
  },
  "If Single Expression": {
    "prefix": "if",
    "body": [
      "if(${1:cond}) $0"
    ],
    "description": "Canonical single-expression if expression (no braces)"
  },
  "Optional Narrowing If": {
    "prefix": "if?",
    "body": [
      "if(${1:opt}?) {",
      "\t$0",
      "}"
    ],
    "description": "Unwrap an optional variable `opt?` to non-optional `opt`"
  },
  "For Range Loop": {
    "prefix": "forr",
    "body": [
      "for(${1:i} in ${2:0}..${3:n}) {",
      "\t$0",
      "}"
    ],
    "description": "Iterate over a half-open integer range"
  },
  "For Collection Loop": {
    "prefix": "forin",
    "body": [
      "for(${1:item} in ${2:items}) {",
      "\t$0",
      "}"
    ],
    "description": "Iterate over a collection"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while(${1:cond}) {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "Match Expression": {
    "prefix": "match",
    "body": [
      "match(${1:value})",
      "when ${2:pattern}: $3",
      "else: $0"
    ],
    "description": "Exhaustive match expression with canonical single-expression arms"
  },
  "Test Function": {
    "prefix": "test",
    "body": [
      "@test",
      "bind test_${1:name} = () void: {",
      "\tassert(${2:true})",
      "}"
    ],
    "description": "Define a unit test function"
  },
  "Unsafe Block": {
    "prefix": "unsafe",
    "body": [
      "unsafe {",
      "\t$0",
      "}"
    ],
    "description": "Unsafe raw pointer / extern C block"
  }
}
